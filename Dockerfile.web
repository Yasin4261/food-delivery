# syntax=docker/dockerfile:1
# Production web image: build the Vue SPA, serve it with Caddy, which also
# terminates TLS and proxies /api to the Go service (see deploy/Caddyfile).

# ---- Build stage ----
FROM node:22-alpine AS build
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ .
# Currency is baked in at build time (Vite inlines VITE_* env). Kept in sync
# with the API's CURRENCY by passing the same value as a build arg (#137).
ARG VITE_CURRENCY=TRY
ENV VITE_CURRENCY=$VITE_CURRENCY
RUN npm run build

# ---- Runtime stage ----
FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
